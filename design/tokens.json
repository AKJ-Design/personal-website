{
  "$schema": "https://alexyoung.com.au/schema/design-tokens-1.json",
  "meta": {
    "name": "Alex Young — shared design spine",
    "locked": "2026-08-15",
    "sources": [
      "personal-website/design/directions.md (Direction B)",
      "personal-website/design/decisions.md",
      "Wayfare/Shared/Support/Theme.swift"
    ],
    "rule": "accent does ALL interactive work; a second interactive colour kills the thread"
  },
  "spine": {
    "typeScale": {
      "ratio": 1.185,
      "steps": {
        "0": "1rem",
        "1": "1.1875rem",
        "2": "1.5rem",
        "3": "2.125rem",
        "4": "3rem",
        "-2": "0.6875rem",
        "-1": "0.8125rem"
      },
      "px": {
        "0": 16,
        "1": 19,
        "2": 24,
        "3": 34,
        "4": 48,
        "-2": 11,
        "-1": 13
      }
    },
    "tracking": {
      "eyebrow": "0.16em",
      "label": "0.10em",
      "display": "-0.024em"
    },
    "leading": {
      "tight": 1.04,
      "head": 1.18,
      "body": 1.6
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.5rem",
      "6": "2rem",
      "7": "3rem",
      "8": "4rem"
    },
    "spacePx": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 24,
      "6": 32,
      "7": 48,
      "8": 64
    },
    "radius": {
      "lg": 20,
      "md": 16,
      "sm": 12,
      "flat": 0
    },
    "measure": "65ch"
  },
  "themes": {
    "fieldNotesLight": {
      "name": "Field Notes Light",
      "surface": {
        "value": "#FAF7F2",
        "note": "ground"
      },
      "surfaceRaised": {
        "value": "#FFFFFF",
        "note": "floating cards (see elevation); article pages still prefer sunk-on-ground"
      },
      "surfaceSunk": {
        "value": "#F4F0E8",
        "note": "code blocks, callouts, placeholder frames"
      },
      "ink": {
        "value": "#141210",
        "onSurface": 17.49,
        "grade": "AAA"
      },
      "muted": {
        "value": "#57514A",
        "onSurface": 7.33,
        "grade": "AAA"
      },
      "muted2": {
        "value": "#6B6358",
        "onSurface": 5.53,
        "grade": "AA",
        "use": "labels + hairlines only, never body copy"
      },
      "accent": {
        "value": "#204E39",
        "onSurface": 8.89,
        "grade": "AAA",
        "role": "ALL interactive work"
      },
      "accentLight": {
        "value": "#2D6A4F",
        "onSurface": 5.98,
        "grade": "AA",
        "use": "hover/active lift only"
      },
      "onAccent": {
        "value": "#FFFFFF",
        "onAccent": 9.5,
        "grade": "AAA"
      },
      "hairline": {
        "alpha": 0.2,
        "of": "accent",
        "rgba": "rgb(32 78 57 / 0.2)",
        "flattened": "#CED5CD"
      },
      "hairlineSoft": {
        "alpha": 0.1,
        "of": "accent",
        "flattened": "#E4E6E0"
      },
      "wash": {
        "alpha": 0.14,
        "of": "accent",
        "flattened": "#DBDFD8"
      },
      "washStrong": {
        "alpha": 0.24,
        "of": "accent",
        "flattened": "#CAD2C9"
      },
      "semantic": {
        "ok": {
          "value": "#2D6A4F",
          "onSurface": 5.98,
          "grade": "AA"
        },
        "warn": {
          "value": "#8A5A1E",
          "onSurface": 5.52,
          "grade": "AA"
        },
        "crit": {
          "value": "#A32E28",
          "onSurface": 6.6,
          "grade": "AA"
        },
        "note": "semantic colour is NOT the accent; in Field Notes Light ok is deliberately a different green from accent"
      },
      "type": {
        "display": "Space Grotesk",
        "body": "system-ui",
        "mono": "JetBrains Mono",
        "displayItalic": false,
        "displayItalicNote": "Space Grotesk ships no italic; never set font-style:italic on display type"
      },
      "radiusCard": 0,
      "elevation": {
        "locked": "2026-08-15",
        "shadow1": "0 1px 2px rgba(20,18,16,0.04), 0 4px 14px rgba(20,18,16,0.06)",
        "shadow2": "0 2px 4px rgba(20,18,16,0.05), 0 12px 32px rgba(20,18,16,0.09)",
        "note": "ink-tinted, never neutral grey; index/link cards only — resting shadow1, hover shadow2 + title turns accent. The live strip and article pages stay flat: if everything floats, nothing does."
      }
    },
    "wayfareDark": {
      "name": "Wayfare Dark",
      "surface": {
        "value": "#0B0A0D",
        "note": "ground"
      },
      "surfaceRaised": {
        "value": "#131217"
      },
      "surfaceSunk": {
        "value": "#16151A"
      },
      "ink": {
        "value": "#F3ECE1",
        "onSurface": 16.83,
        "grade": "AAA"
      },
      "muted": {
        "value": "#A89E8F",
        "onSurface": 7.48,
        "grade": "AAA"
      },
      "muted2": {
        "value": "#8F8676",
        "onSurface": 5.49,
        "grade": "AA",
        "use": "labels + hairlines only, never body copy"
      },
      "accent": {
        "value": "#C9A15F",
        "onSurface": 8.22,
        "grade": "AAA",
        "role": "ALL interactive work"
      },
      "accentLight": {
        "value": "#E3C088",
        "onSurface": 11.44,
        "grade": "AAA",
        "use": "hover/active lift only"
      },
      "onAccent": {
        "value": "#1A1409",
        "onAccent": 7.62,
        "grade": "AAA"
      },
      "hairline": {
        "alpha": 0.16,
        "of": "accent",
        "rgba": "rgb(201 161 95 / 0.16)",
        "flattened": "#29221A"
      },
      "hairlineSoft": {
        "alpha": 0.08,
        "of": "accent",
        "flattened": "#1A1614"
      },
      "wash": {
        "alpha": 0.14,
        "of": "accent",
        "flattened": "#261F18"
      },
      "washStrong": {
        "alpha": 0.24,
        "of": "accent",
        "flattened": "#392E21"
      },
      "semantic": {
        "ok": {
          "value": "#69BA7C",
          "onSurface": 8.38,
          "grade": "AAA"
        },
        "warn": {
          "value": "#E28D4F",
          "onSurface": 7.67,
          "grade": "AAA"
        },
        "crit": {
          "value": "#DC655F",
          "onSurface": 5.71,
          "grade": "AA"
        },
        "note": "semantic colour is NOT the accent; in Field Notes Light ok is deliberately a different green from accent"
      },
      "type": {
        "display": "Newsreader",
        "body": "Manrope",
        "mono": "IBM Plex Mono",
        "displayItalic": true
      },
      "radiusCard": 12,
      "elevation": {
        "shadow1": "none",
        "shadow2": "none",
        "note": "a dark theme lifts with lighter surfaces, not shadows — surfaceRaised does the work"
      }
    }
  },
  "categoryPalette": {
    "note": "Wayfare only. LABELS, never states, never interactive. Converted oklch -> sRGB, no gamut clipping.",
    "flight": "#E8605B",
    "gym": "#5894D0",
    "food": "#E28D4F",
    "night": "#A272D4",
    "explore": "#5DAD70",
    "relax": "#63B5B4",
    "shop": "#D887AE"
  },
  "terminalExtension": {
    "note": "Wayfare Dark only. Three colours ANSI requires that this system does not otherwise author. NOT light variants of the category palette - the categories are flat labels with no hover state, and a --cat-*-light tier would import a terminal constraint into the design language.",
    "rule": "Apply the accent -> accentLight relationship (L +0.094, C -0.014, hue held) to the source colour's oklch. It REDUCES chroma as it lightens, which is what stops the brights going neon. Derive, never pick by eye.",
    "promoted": "2026-08-28",
    "brightBlue": {
      "value": "#7CB1E7",
      "from": "gym",
      "oklch": "74.4% 0.096 250",
      "onSurface": 8.74,
      "grade": "AAA"
    },
    "brightMagenta": {
      "value": "#BD92ED",
      "from": "night",
      "oklch": "73.4% 0.136 305",
      "onSurface": 7.99,
      "grade": "AAA"
    },
    "brightCyan": {
      "value": "#8FD0CF",
      "from": "relax",
      "oklch": "81.4% 0.066 195",
      "onSurface": 11.37,
      "grade": "AAA"
    }
  }
}
