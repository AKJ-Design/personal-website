---
/**
 * Base layout — the HTML shell every page shares.
 *
 * Structure mirrors design/mocks/home.html exactly: the header is full-bleed
 * with .page on its inner row, then one .page wrapper holds the content and the
 * footer. Don't nest the header inside the wrapper — the blur and the bottom
 * hairline need to run edge to edge.
 */
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  /** Page title, without the site suffix. */
  title: string;
  /** Meta description. Required — build plan §2.5 wants one per page. */
  description: string;
  /** OG card path; posts pass their own, everything else gets the site card. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogImage = '/og/site.png', ogType = 'website' } = Astro.props;

/* Canonical tags, per §2.5. Astro.site comes from astro.config.mjs, so this is
   correct on the workers.dev preview and on the custom domain without a flag. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    {/* OG + Twitter (build plan §2.5). Image URLs are absolute against the
        canonical domain — scrapers don't resolve relative paths. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Alex Young — build log"
      href={new URL('/rss.xml', Astro.site)}
    />

    {/* Both faces preload: each is a single variable WOFF2 (22 KB / 40 KB) and
        both are used above the fold — the wordmark is display, the nav is mono.
        Body copy uses the system stack, so nothing here blocks first paint. */}
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>

  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Header />
    <div class="page">
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
