---
/**
 * The live status strip — the signature element.
 *
 * STEP 7 STATE: fed from Workers KV. An hourly launchd job on the MacBook
 * (home-lab/scripts/strip-snapshot.sh) pushes a snapshot; `/` is the site's one
 * non-prerendered route and reads it server-side. Cloudflare never reaches into
 * the tailnet — the perimeter rule in principles.md — so the data comes to it.
 *
 * All the parsing, validation and degrade logic lives in lib/strip.ts. This file
 * only draws. Given a StripView it cannot fail: the view always has four cells and
 * a stamp, whatever state KV was in.
 *
 * Zero client JS, as everywhere else. The pulsing dot is CSS, and it stops pulsing
 * when the values stop being current — a moving dot over a two-day-old snapshot
 * would be the page lying with animation.
 *
 * Deliberately NOT a floating card: the strip keeps the flat survey-sheet
 * treatment while the project cards float. If everything floats, nothing does.
 *
 * PRIVACY (build plan §2.3): every value arrives already coarsened — the workout as
 * a category and a day-relative age, services as a COUNT from an explicit
 * allow-list of services-VM checks, weather at city resolution. Nothing here can
 * make a value finer, because nothing finer is ever sent.
 */
import type { StripView } from '../lib/strip';

interface Props {
  view: StripView;
}

const { view } = Astro.props;
---

<section class="strip" aria-label="Live status">
  {view.cells.map(({ label, value }) => (
    <div class="cell">
      <span class="key">{label}</span>
      <span class="val">{value}</span>
    </div>
  ))}
  <div class="stamp">
    <span class:list={['live-dot', view.state]}></span>{view.stamp}
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    align-items: center;
  }
  .strip .cell {
    padding: var(--space-3) var(--space-4);
    border-left: 1px solid var(--hairline-soft);
  }
  .strip .cell:first-child { border-left: none; padding-left: 0; }
  .strip .key {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }
  .strip .val {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .strip .stamp {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted-2);
    text-align: right;
    padding-left: var(--space-4);
    white-space: nowrap;
  }

  /* The one moving thing on the page. --ok, NOT --accent: "live" is a status,
     not an interactive control, and the accent thread stays reserved for
     interaction. */
  .live-dot {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--ok);
    margin-right: var(--space-2);
    vertical-align: 1px;
  }
  /* Only the current state animates. A pulsing dot above a two-day-old snapshot
     would be the page asserting "live" with motion while its own stamp says
     otherwise — and motion is the more persuasive of the two. --warn carries the
     degraded states, so the row reads as stale at a glance and on close reading. */
  .live-dot.fresh { animation: pulse 2.4s ease-out infinite; }
  .live-dot.stale,
  .live-dot.absent { background: var(--warn); }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 45%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot.fresh { animation: none; }
  }

  @media (max-width: 720px) {
    .strip { grid-template-columns: 1fr 1fr; }
    .strip .cell {
      border-left: none;
      border-top: 1px solid var(--hairline-soft);
      padding-left: 0;
    }
    .strip .cell:nth-child(-n+2) { border-top: none; }
    .strip .stamp {
      grid-column: 1 / -1;
      text-align: left;
      padding: 0 0 var(--space-2);
    }
  }
</style>
