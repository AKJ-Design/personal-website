---
/**
 * HOME — build plan step 4.
 *
 * Matches design/mocks/home.html rev 4. Copy is verbatim from
 * ../../content/home.md, per the content-before-pixels rule ("the mocks use
 * this copy verbatim") — if a line here and a line there ever disagree,
 * content/home.md is right.
 *
 * The hero hook opens "I'm Alex," to match /about (decision 2026-08-23). The
 * full name does the entity-consistency work in the wordmark, the <title> and
 * the Person structured data instead.
 *
 * STEP 7: this is the site's ONE non-prerendered route, so the strip can read its
 * snapshot out of KV at request time. Everything else on the site stays a static
 * asset. Nothing here needs client JS either way — the pulsing dot is CSS.
 */
import Base from '../layouts/Base.astro';
import Strip from '../components/Strip.astro';
import Card from '../components/Card.astro';
import PostCard from '../components/PostCard.astro';
import { PROJECTS } from '../data/projects';
import { publishedPosts, postMeta } from '../lib/posts';
import { stripView } from '../lib/strip';

/* Bindings come from `cloudflare:workers`, NOT `Astro.locals.runtime.env`, which
   Astro 6 removed — its getter now throws, telling you to import this instead.
   Worth knowing how that presented: the throw landed in the catch below and the
   page degraded to "snapshot unavailable", looking exactly like an empty KV. A
   clean degrade path will hide a bug from you if you let it, which is why the
   catch logs (see below) rather than only swallowing.

   `env` is typed by worker-configuration.d.ts — regenerate with
   `npm run generate-types` after changing a binding in wrangler.jsonc. */
import { env } from 'cloudflare:workers';

/* The one route that runs on request rather than at build. Everything below the
   strip is identical on every request; this exists solely so four lines of the
   page can be current. That trade is the whole of build plan §2.3. */
export const prerender = false;

/* KV can be absent in ordinary ways — the key never written, the read failing
   mid-flight — and none of them is a reason to 500 the front door. stripView()
   turns null into a rendered row.

   The console.error matters: observability is on in wrangler.jsonc, so a read
   that starts failing leaves a trace in the Worker logs instead of quietly
   presenting as "the laptop must be asleep". */
let snapshot: string | null = null;
try {
  snapshot = (await env.STRIP.get('strip')) ?? null;
} catch (err) {
  console.error('strip: KV read failed', err);
}
const strip = stripView(snapshot);

/* Counts are rendered, not typed, so the labels cannot drift from the source.
   decisions.md: "plate values are claims — every one must be literally true."
   Posts come from the blog collection via lib/posts.ts — the same source
   /blog/, /about's plate, RSS and the OG routes read. */
const POSTS = (await publishedPosts()).map(postMeta);
const projectCount = String(PROJECTS.length).padStart(2, '0');
const postCount = String(POSTS.length).padStart(2, '0');
---

<Base
  title="Alex Young — build log"
  description="Portfolio and build log: a travel app I built and shipped, a knowledge base my AI tools read and write, and a fitness pipeline I review every week. What I made, the trade-offs, and what I'd do differently."
>
  <section class="hero">
    <p class="eyebrow">Field notes · est. 2026 · Brisbane, AU</p>
    <h1>I run my life on <em>my own APIs</em>.</h1>
    <p class="lead">
      A travel app I built and shipped, a knowledge base my AI tools read and
      write, a fitness pipeline I actually review every week. This site is the
      portfolio and the build log behind it: what I made, the decisions and
      trade-offs, and what I'd do differently.
    </p>
  </section>

  <Strip view={strip} />

  <section class="projects" id="projects">
    <h2 class="section-label">Projects — {projectCount}</h2>
    <div class="projects-grid">
      {PROJECTS.map((project) => <Card project={project} />)}
    </div>
  </section>

  <section class="writing" id="writing">
    <h2 class="section-label">Writing — {postCount}</h2>
    {POSTS.map((post) => <PostCard {...post} />)}
    <p class="upcoming">next up — QuietNine: the launch story</p>
  </section>
</Base>

<style>
  .hero { padding: var(--space-8) 0 var(--space-7); }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
    max-width: 22ch;
  }
  .hero h1 em {
    font-style: normal; /* Space Grotesk has no italic — emphasis is the accent */
    color: var(--accent);
  }
  .hero .lead {
    margin-top: var(--space-5);
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--measure);
  }

  .projects { margin-top: var(--space-8); }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .writing { margin-top: var(--space-8); }
  .writing .upcoming {
    margin-top: var(--space-4);
    font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--muted-2);
  }

  @media (max-width: 720px) {
    .hero { padding: var(--space-7) 0 var(--space-6); }
    .hero h1 { font-size: var(--step-3); }
    .projects-grid { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
