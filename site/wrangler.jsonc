// Source config. NOTE: `wrangler deploy` does NOT use this file directly —
// the adapter writes a resolved copy to dist/client/wrangler.json and points
// wrangler at it via .wrangler/deploy/config.json ("redirected configuration").
// That is why `assets.directory` below reads ./dist while the real assets are
// in dist/client. Edit this file; never the generated one.
//
// `name` sets the *.workers.dev preview hostname: alexyoung-com-au.<subdomain>.workers.dev
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "alexyoung-com-au",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	// The live strip (step 7). The ONLY binding this site has, and the only reason
	// `/` is server-rendered — every other route is a static file.
	//
	// Read-only from the Worker's side. Nothing in this codebase writes to it: the
	// snapshot is PUSHED hourly from the MacBook by home-lab/scripts/strip-snapshot.sh,
	// because a Worker that could fetch these values would have to be able to reach
	// into the tailnet, which is the thing the whole design refuses to do.
	//
	// If `wrangler deploy --dry-run` ever lists a binding other than this and ASSETS,
	// an adapter default has been re-enabled — see astro.config.mjs and site/README.md.
	"kv_namespaces": [
		{
			"binding": "STRIP",
			"id": "1224900da14a40c2bc12187d1a6e680c"
		}
	],

	// Step 8 — the real address. `custom_domain: true` makes Cloudflare own the whole
	// chain on deploy: it creates the apex DNS record in the zone and issues the edge
	// certificate, so there is nothing to hand-create and nothing to drift. A plain
	// `routes` pattern would only match traffic that already reached the zone; this
	// makes the hostname exist. Note what it does NOT touch: the MX/SPF/DKIM records
	// that Email Routing manages sit beside it untouched — a custom domain is one
	// A/AAAA-equivalent record at the apex, not a takeover of the zone.
	//
	// `www` is deliberately NOT a second custom domain here. Static assets are served
	// by the ASSETS binding before any Astro code runs, so a redirect written in
	// middleware would never fire for /about/ or /blog/. The www → apex redirect is a
	// Cloudflare Redirect Rule at the edge instead, with a proxied placeholder record
	// — see the repo README's step 8 notes.
	"routes": [
		{ "pattern": "alexyoung.com.au", "custom_domain": true }
	],

	// Both OFF, and stated rather than left to wrangler's default (which prints a
	// warning on every deploy). The workers.dev host served identical HTML to the real
	// domain, and once robots.txt allows crawling, a second host with the same person
	// on it is exactly the common-name competition design plan §8 exists to prevent.
	// Preview URLs are also workers.dev hosts, unguessable but still crawlable if ever
	// linked; the same reasoning retires them. A branch push still uploads a version —
	// it just has no public URL until promoted.
	"workers_dev": false,
	"preview_urls": false,

	"observability": {
		"enabled": true
	}
}
